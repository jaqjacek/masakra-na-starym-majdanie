{
  "openapi": "3.0.0",
  "info": {
    "title": "MASAKRA na Starym Majdanie API",
    "description": "Interactive API Documentation for the MASAKRA na Starym Majdanie Game Engine.",
    "version": "1.13.0"
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/api/ping": {
      "get": {
        "summary": "Health Check",
        "responses": { "200": { "description": "Returns 'pong'" } }
      }
    },
    "/api/config": {
      "get": {
        "summary": "Get Global Configuration",
        "responses": { "200": { "description": "Returns global server configuration" } }
      },
      "post": {
        "summary": "Update Global Configuration",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "defaultSetName": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Configuration updated" } }
      }
    },
    "/api/config/title": {
      "get": {
        "summary": "Get Dynamic Game Title",
        "description": "Returns the current game title as defined in game_config.json.",
        "responses": { 
          "200": { 
            "description": "Game title retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "title": { "type": "string" } }
                }
              }
            }
          } 
        }
      }
    },
    "/api/map/next-id": {
      "get": {
        "summary": "Get Next Available Game ID",
        "responses": { "200": { "description": "Returns the next available numeric game ID" } }
      }
    },
    "/api/sets": {
      "get": {
        "summary": "List Available Sets",
        "responses": { "200": { "description": "Array of set names" } }
      }
    },
    "/api/sets/details/{setName}": {
      "get": {
        "summary": "Get Set Details",
        "parameters": [
          { "name": "setName", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Full JSON structure of the requested set" } }
      }
    },
    "/api/sets/generate": {
      "post": {
        "summary": "Generate a new pawn set",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pawns": { "type": "object" },
                  "power": { "type": "object" },
                  "maxPower": { "type": "number" },
                  "displayName": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Set generated" } }
      }
    },
    "/api/sets/duplicate/{setName}": {
      "post": {
        "summary": "Duplicate an existing set",
        "parameters": [
          {
            "name": "setName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Set duplicated successfully"
          },
          "404": {
            "description": "Source set not found"
          }
        }
      }
    },
    "/api/map/{gameId}": {
      "get": {
        "summary": "Get Game State",
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Current game state JSON" } }
      },
      "post": {
        "summary": "Save Game State",
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": { "application/json": { "schema": { "type": "object" } } }
        },
        "responses": { "200": { "description": "State saved" } }
      },
      "delete": {
        "summary": "Reset Board",
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Board reset to empty" } }
      }
    },
    "/api/map/status/{gameId}": {
      "get": {
        "summary": "Get simplified game status",
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Basic player info and points" } }
      }
    },
    "/api/map/init/{gameId}": {
      "post": {
        "summary": "Initialize New Game",
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "set", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Game initialized" } }
      }
    },
    "/api/map/{gameId}/event-phase": {
      "post": {
        "summary": "Execute Event Phase",
        "description": "Draws a random event, applies its effects, and transitions the game to the next round or final scoring.",
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { 
          "200": { "description": "Event phase completed and state updated" },
          "500": { "description": "Failed to execute event phase" }
        }
      }
    },
    "/api/map/{gameId}/trigger-event/{eventId}": {
      "post": {
        "summary": "Trigger a Specific Event Manually",
        "description": "Applies the effects of a specific event (by its ID) to the game immediately, useful for manual testing and debugging.",
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "eventId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Event triggered and applied successfully" },
          "404": { "description": "Event not found" },
          "500": { "description": "Failed to trigger event" }
        }
      }
    },
    "/api/map/{gameId}/saves": {
      "get": {
        "summary": "List Round Saves",
        "description": "Returns a list of round numbers for which backup saves exist in the game session directory.",
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of round numbers retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "saves": { "type": "array", "items": { "type": "integer" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/map/{gameId}/load-round/{round}": {
      "post": {
        "summary": "Load Round Save",
        "description": "Restores the state of a specific round from backup files, updates the game state, deletes all backups of subsequent rounds, and broadcasts the state.",
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "round", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Round save loaded and state restored successfully" },
          "400": { "description": "Invalid round number" },
          "500": { "description": "Failed to load round save" }
        }
      }
    },
    "/api/simulate/": {
      "post": {
        "summary": "Run Quick Simulation",
        "parameters": [
          { "name": "set", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "setsData": { "type": "object", "description": "Optional custom sets data" },
                  "eventsData": { "type": "array", "description": "Optional custom events list" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Simulation results" } }
      }
    },
    "/api/simulate/detailed": {
      "post": {
        "summary": "Run Comprehensive Simulation",
        "parameters": [
          { "name": "set", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "setsData": { "type": "object", "description": "Optional custom sets data" },
                  "eventsData": { "type": "array", "description": "Optional custom events list" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Detailed simulation history" } }
      }
    },
    "/api/simulate/full": {
      "post": {
        "summary": "Run Simulation with Full Config",
        "description": "Accepts complete JSON objects for sets, game, and events parameters. Supports both JSON body and multipart/form-data file uploads.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sets": { "type": "object", "description": "Full sets configuration object" },
                  "game": { 
                    "type": "object", 
                    "description": "Game configuration parameters (rounds, draw amounts, etc.)"
                  },
                  "events": {
                    "type": "array",
                    "description": "Optional custom events list"
                  }
                },
                "required": ["sets"]
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "sets": { "type": "string", "format": "binary", "description": "JSON file with sets configuration" },
                  "game": { "type": "string", "format": "binary", "description": "JSON file with game configuration" },
                  "events": { "type": "string", "format": "binary", "description": "JSON file with custom events list" }
                },
                "required": ["sets"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Simulation analytics result" },
          "400": { "description": "Missing required configuration or invalid JSON in files" }
        }
      }
    }
  }
}
