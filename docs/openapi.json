{
  "openapi": "3.0.0",
  "info": {
    "title": "MASAKRA na Starym Majdanie API",
    "description": "Interactive API Documentation for the MASAKRA na Starym Majdanie Game Engine. Real-time actions use Socket.io events (action:placeSet, action:movePawn, action:selectGeneral, action:kablowanieSet, action:passTurn).",
    "version": "1.20.1"
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/api/ping": {
      "get": {
        "summary": "Health Check",
        "responses": { "200": { "description": "Returns 'pong'" } }
      }
    },
    "/api/config": {
      "get": {
        "summary": "Get Global Configuration",
        "responses": { "200": { "description": "Returns global server configuration" } }
      },
      "post": {
        "summary": "Update Global Configuration",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "defaultSetName": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Configuration updated" } }
      }
    },
    "/api/config/title": {
      "get": {
        "summary": "Get Dynamic Game Title",
        "description": "Returns the current game title as defined in game_config.json.",
        "responses": { 
          "200": { 
            "description": "Game title retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "title": { "type": "string" } }
                }
              }
            }
          } 
        }
      }
    },
    "/api/map/next-id": {
      "get": {
        "summary": "Get Next Available Game ID",
        "responses": { "200": { "description": "Returns the next available numeric game ID" } }
      }
    },
    "/api/sets": {
      "get": {
        "summary": "List Available Sets",
        "responses": { "200": { "description": "Array of set names" } }
      }
    },
    "/api/sets/details/{setName}": {
      "get": {
        "summary": "Get Set Details",
        "parameters": [
          { "name": "setName", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Full JSON structure of the requested set" } }
      }
    },
    "/api/sets/generate": {
      "post": {
        "summary": "Generate a new pawn set",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pawns": { "type": "object" },
                  "power": { "type": "object" },
                  "maxPower": { "type": "number" },
                  "displayName": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Set generated" } }
      }
    },
    "/api/sets/generate/transient": {
      "post": {
        "summary": "Generate a new pawn set transiently without saving to disk",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pawns": { "type": "object", "description": "Totals pool per band" },
                  "pawnsInPlayLimit": { "type": "object", "description": "Limits per band" },
                  "power": { "type": "object" },
                  "maxPower": { "type": "number" },
                  "displayName": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Generated set JSON structure" } }
      }
    },
    "/api/sets/duplicate/{setName}": {
      "post": {
        "summary": "Duplicate an existing set",
        "parameters": [
          {
            "name": "setName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": { "description": "Set duplicated successfully" },
          "404": { "description": "Source set not found" }
        }
      }
    },
    "/api/sets/save/{setName}": {
      "post": {
        "summary": "Save set configuration",
        "parameters": [
          { "name": "setName", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "setsData": { "type": "object", "description": "Sets configuration data" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Set saved and cleaned successfully" },
          "404": { "description": "Set not found" }
        }
      }
    },
    "/api/sets/sort/{setName}": {
      "post": {
        "summary": "Sort pawns and piles in set",
        "parameters": [
          { "name": "setName", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Set sorted successfully" },
          "404": { "description": "Set not found" }
        }
      }
    },
    "/api/sets/default/{setName}": {
      "post": {
        "summary": "Set set as global default for new games",
        "parameters": [
          { "name": "setName", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "setsData": { "type": "object", "description": "Optional set payload to save and apply" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Set configured as default" },
          "404": { "description": "Source set not found" }
        }
      }
    },
    "/api/events": {
      "get": {
        "summary": "List Available Event Lists",
        "responses": { "200": { "description": "Array of event list names" } }
      }
    },
    "/api/events/all": {
      "get": {
        "summary": "Get Master Events List",
        "description": "Returns the complete master list of all possible game events from events_all.json.",
        "responses": {
          "200": { "description": "Master events array" },
          "404": { "description": "Master events file not found" }
        }
      }
    },
    "/api/events/details/{listName}": {
      "get": {
        "summary": "Get Event List Details",
        "parameters": [
          { "name": "listName", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Event list items array" },
          "404": { "description": "Event list not found" }
        }
      }
    },
    "/api/events/create": {
      "post": {
        "summary": "Create a New Event List",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "description": "Name for the new event list" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Event list created" },
          "400": { "description": "Invalid name or list already exists" }
        }
      }
    },
    "/api/events/save/{listName}": {
      "post": {
        "summary": "Save Event List",
        "parameters": [
          { "name": "listName", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "eventsData": { "type": "array", "items": { "type": "object" }, "description": "Events array" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Event list saved successfully" },
          "404": { "description": "Event list not found" }
        }
      }
    },
    "/api/events/default/{listName}": {
      "post": {
        "summary": "Set Default Event List",
        "parameters": [
          { "name": "listName", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "eventsData": { "type": "array", "items": { "type": "object" }, "description": "Optional events array payload" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Event list set as default" },
          "404": { "description": "Source event list not found" }
        }
      }
    },
    "/api/map": {
      "delete": {
        "summary": "Delete All Games",
        "description": "Deletes all active game sessions and cleans the server/games directory.",
        "responses": { "200": { "description": "All games deleted" } }
      }
    },
    "/api/map/{gameId}": {
      "get": {
        "summary": "Get Game State",
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Current game state JSON" } }
      },
      "post": {
        "summary": "Save Game State (Deprecated)",
        "deprecated": true,
        "description": "DEPRECATED: Use Socket.io event actions (action:placeSet, action:movePawn, etc.) instead of HTTP POST state dumps.",
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": { "application/json": { "schema": { "type": "object" } } }
        },
        "responses": { "200": { "description": "State saved (Deprecated fallback)" } }
      },
      "delete": {
        "summary": "Reset Board",
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Board reset to empty" } }
      }
    },
    "/api/map/status/{gameId}": {
      "get": {
        "summary": "Get simplified game status",
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Basic player info and points" } }
      }
    },
    "/api/map/init/{gameId}": {
      "post": {
        "summary": "Initialize New Game",
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "set", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Game initialized" } }
      }
    },
    "/api/map/{gameId}/add": {
      "get": {
        "summary": "Add Pawn to Region",
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "region", "in": "query", "required": true, "schema": { "type": "integer" } },
          { "name": "pawn", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Pawn added" }, "400": { "description": "Invalid region" } }
      }
    },
    "/api/map/{gameId}/remove": {
      "get": {
        "summary": "Remove Pawn from Region",
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "region", "in": "query", "required": true, "schema": { "type": "integer" } },
          { "name": "pawn", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Pawn removed" }, "400": { "description": "Pawn not found in region" } }
      }
    },
    "/api/map/{gameId}/event-phase": {
      "post": {
        "summary": "Execute Event Phase",
        "description": "Draws a random event, applies its effects, and transitions the game to the next round or final scoring.",
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { 
          "200": { "description": "Event phase completed and state updated" },
          "500": { "description": "Failed to execute event phase" }
        }
      }
    },
    "/api/map/{gameId}/trigger-event/{eventId}": {
      "post": {
        "summary": "Trigger a Specific Event Manually",
        "description": "Applies the effects of a specific event (by its ID) to the game immediately, useful for manual testing and debugging.",
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "eventId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Event triggered and applied successfully" },
          "404": { "description": "Event not found" },
          "500": { "description": "Failed to trigger event" }
        }
      }
    },
    "/api/map/{gameId}/saves": {
      "get": {
        "summary": "List Available Snapshots",
        "description": "Returns a list of saved round snapshots for the specified game session.",
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of snapshot IDs retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "saves": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/map/{gameId}/load-snapshot/{snapshotId}": {
      "post": {
        "summary": "Restore Game Snapshot",
        "description": "Restores the game state from a specific snapshot and broadcasts to all connected players.",
        "parameters": [
          { "name": "gameId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "snapshotId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Snapshot restored successfully" },
          "500": { "description": "Failed to load snapshot" }
        }
      }
    },
    "/api/simulate/job": {
      "post": {
        "summary": "Submit Parallel Monte Carlo Simulation Job",
        "description": "Spawns Node.js Worker Threads across CPU cores to run high-volume Monte Carlo simulations asynchronously.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "count": { "type": "integer", "default": 1000, "description": "Number of simulations to run" },
                  "sets": { "type": "object", "description": "Optional sets configuration" },
                  "game": { "type": "object", "description": "Optional game configuration" },
                  "events": { "type": "array", "description": "Optional events array" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Job created" } }
      }
    },
    "/api/simulate/job/{jobId}": {
      "get": {
        "summary": "Get Parallel Simulation Job Status & Progress",
        "parameters": [
          { "name": "jobId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Job status, progress percent, and final balance report when completed" } }
      }
    },
    "/api/simulate/batch": {
      "post": {
        "summary": "Run Batch Simulation",
        "parameters": [
          { "name": "set", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "count", "in": "query", "required": false, "schema": { "type": "integer", "default": 100 } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "setsData": { "type": "object", "description": "Optional custom sets data" },
                  "eventsData": { "type": "array", "description": "Optional custom events list" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Batch simulation results array" } }
      }
    },
    "/api/simulate/": {
      "post": {
        "summary": "Run Quick Simulation",
        "parameters": [
          { "name": "set", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "setsData": { "type": "object", "description": "Optional custom sets data" },
                  "eventsData": { "type": "array", "description": "Optional custom events list" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Simulation results" } }
      }
    },
    "/api/simulate/detailed": {
      "post": {
        "summary": "Run Comprehensive Simulation",
        "parameters": [
          { "name": "set", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "setsData": { "type": "object", "description": "Optional custom sets data" },
                  "eventsData": { "type": "array", "description": "Optional custom events list" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Detailed simulation history" } }
      }
    },
    "/api/simulate/full": {
      "post": {
        "summary": "Run Simulation with Full Config",
        "description": "Accepts complete JSON objects for sets, game, and events parameters. Supports both JSON body and multipart/form-data file uploads. If configurations are omitted, falls back to default server configurations.",
        "parameters": [
          { "name": "count", "in": "query", "required": false, "schema": { "type": "integer", "default": 1 } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sets": { "type": "object", "description": "Full sets configuration object" },
                  "game": { 
                    "type": "object", 
                    "description": "Game configuration parameters (rounds, draw amounts, etc.)"
                  },
                  "events": {
                    "type": "array",
                    "description": "Optional custom events list"
                  },
                  "count": { "type": "integer", "description": "Number of simulations to run" }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "sets": { "type": "string", "format": "binary", "description": "JSON file with sets configuration" },
                  "game": { "type": "string", "format": "binary", "description": "JSON file with game configuration" },
                  "events": { "type": "string", "format": "binary", "description": "JSON file with custom events list" },
                  "count": { "type": "string", "description": "Number of simulations to run" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Simulation analytics result array" },
          "400": { "description": "Invalid JSON in files" }
        }
      }
    }
  }
}
